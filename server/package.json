{
  "name": "discord-lite",
  "productName": "Discord Lite",
  "version": "1.0.0",
  "description": "Local Discord-style chat app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.andrew.discordlite",
    "productName": "Discord Lite",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!Send/**",
      "!Share/**",
      "!runtime/**",
      "!build-resources/**",
      "!**/*.bat",
      "!**/*.vbs",
      "!**/_*.js",
      "!database.sqlite",
      "!uploads/**"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Discord-Lite-Portable.exe"
    },    "portable": {
      "artifactName": "Discord-Lite-Portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Discord Lite",
      "artifactName": "Discord-Lite-Setup.exe"
    }
  }
}
